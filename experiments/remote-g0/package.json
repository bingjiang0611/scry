{
  "name": "scry-remote-g0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "node generate-wire.mjs",
    "check:generated": "node generate-wire.mjs --check",
    "test": "node --test *.test.mjs",
    "build:swift": "swift build --package-path swift -j 4",
    "smoke": "node smoke.mjs",
    "smoke:enrollment": "node enrollment-smoke.mjs",
    "smoke:pair": "node pair-smoke.mjs",
    "smoke:g1": "node --import ./ts-relative-resolve.mjs g1-smoke.mjs",
    "smoke:relay": "node --import ./ts-relative-resolve.mjs relay-e2e.mjs",
    "smoke:relay-pair": "node --import ./ts-relative-resolve.mjs relay-pair-smoke.mjs",
    "smoke:relay-run": "swift build --package-path swift && node --experimental-transform-types --import ./ts-relative-resolve.mjs relay-run-smoke.mjs",
    "smoke:cf": "node cf-relay-smoke.mjs && node cf-relay-lifecycle-smoke.mjs",
    "smoke:cf-host": "node --import ./ts-relative-resolve.mjs cf-relay-host-smoke.mjs",
    "smoke:cf-pair": "node --import ./ts-relative-resolve.mjs cf-relay-pair-smoke.mjs"
  },
  "dependencies": {
    "@peculiar/x509": "2.1.0",
    "reflect-metadata": "0.2.2",
    "ws": "8.21.3"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "wrangler": "^3.114.17"
  }
}
