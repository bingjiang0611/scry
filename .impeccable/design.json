      "css": ".ds-button-secondary { font-family: var(--font-ui); line-height: 1.55; display: inline-flex; align-items: center; gap: 7px; min-height: 40px; padding: 6px 12px; border: 1px solid var(--border2); background: var(--panel); border-radius: var(--r-md); font-size: 12.5px; color: var(--fg); cursor: pointer; transition: background-color 140ms ease-out, border-color 140ms ease-out, color 140ms ease-out, transform 160ms var(--ease-out); }.ds-button-secondary:hover { border-color: var(--accent-line); background: var(--panel3); }.ds-button-secondary:focus-visible { outline: 2px solid var(--accent-line); outline-offset: 2px; }.ds-button-secondary:disabled { opacity: .45; cursor: not-allowed; } .ds-button-secondary:not(:disabled):active { transform: scale(.96); }"
