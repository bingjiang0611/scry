      "css": ".ds-search { display: flex; align-items: center; gap: 6px; border: 0; margin: 0; min-height: 36px; padding: 0 10px; background: var(--panel3); border-color: transparent; border-radius: 10px; height: 36px; flex: none; }.ds-search input { font-family: var(--font-ui); line-height: 1.55; flex: 1; background: none; border: 0; outline: 0; font-size: 13px; color: var(--fg); align-self: center; min-height: 0; }.ds-search input::placeholder { color: var(--dim3); }.ds-search:focus-within { background: var(--panel); border-color: var(--accent-line); box-shadow: 0 0 0 1px var(--accent-line),\n    0 0 0 4px var(--accent-soft); }.ds-search input:focus-visible { outline: 2px solid var(--accent-line); outline-offset: 2px; }"
