      "html": "<button type=\"button\" class=\"ds-button-primary\">保存 ⌘S</button>",
      "css": ".ds-button-primary { font-family: var(--font-ui); line-height: 1.55; display: inline-flex; align-items: center; gap: 7px; min-height: 40px; padding: 6px 12px; border: 1px solid var(--border2); background: var(--accent); border-radius: var(--r-md); font-size: 12.5px; color: var(--accent-fg); cursor: pointer; transition: background-color 140ms ease-out, border-color 140ms ease-out, color 140ms ease-out, transform 160ms var(--ease-out); border-color: var(--accent); font-weight: 600; }.ds-button-primary:hover { border-color: color-mix(in srgb, var(--accent) 88%, white); background: color-mix(in srgb, var(--accent) 88%, white); }.ds-button-primary:focus-visible { outline: 2px solid var(--accent-line); outline-offset: 2px; }.ds-button-primary:disabled { opacity: .45; cursor: not-allowed; } .ds-button-primary:not(:disabled):active { transform: scale(.96); }"
    },
    {
